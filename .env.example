# ==============================================================================
# 1. BẮT BUỘC & CẤU HÌNH CỐT LÕI (Server, Supabase, OAuth, CORS)
# ==============================================================================
NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1
PUBLIC_SITE_URL=http://localhost:5500/FOODSAVE_USER.html

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
FACEBOOK_OAUTH_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
GOOGLE_OTP_EXPIRES_SECONDS=600
PHONE_OTP_EXPIRES_SECONDS=600

# Bí mật riêng (>= 32 ký tự) để ký token tình nguyện viên (tùy chọn; trống sẽ dùng fallback kế thừa)
VOLUNTEER_TOKEN_SECRET=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://10.0.2.2:8081

# ==============================================================================
# 2. THANH TOÁN & CHI TRẢ (Payment / MoMo / Payout / Mã hóa số tài khoản)
# ==============================================================================
PAYMENT_PROVIDER=simulated
PAYOUT_PROVIDER=manual

# Khóa mã hóa AES-256-GCM (32 byte dạng base64 hoặc 64 ký tự hex). Sinh bằng: npm run gen:payout-key
PAYOUT_ENCRYPTION_KEY=
# Đa khóa xoay vòng dạng "v2:<64hex>,v1:<64hex>" (ưu tiên dùng khóa đầu để mã hóa mới, tự dò khóa cũ khi giải mã)
PAYOUT_ENCRYPTION_KEYS=

MOMO_API_BASE_URL=https://test-payment.momo.vn/v2/gateway/api
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=YOUR_MOMO_TEST_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_TEST_SECRET_KEY
MOMO_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
MOMO_IPN_URL=http://localhost:8080/api/v1/orders/payments/momo/webhook/mock

# ==============================================================================
# 3. TỰ ĐỘNG HÓA, CHÍNH SÁCH VẬN HÀNH & MARKETING (Automation / Demo / n8n / FB)
# ==============================================================================
AUTOMATION_ENABLED=false
LABEL_AUTOMATION_INTERVAL_MS=300000
PHOTO_REVIEW_MINUTES=360
PHOTO_GPS_MAX_METERS=500
DEMO_MODE=false
ORDER_POLICY_TIME_SCALE=1

N8N_WEBHOOK_URL=
N8N_SECRET=
N8N_CENTRAL_WEBHOOK_URL=
FACEBOOK_PAGE_TOKENS=
CENTRAL_PAGE_ID=
CENTRAL_PAGE_NAME=

# ==============================================================================
# 4. THÔNG BÁO ĐẨY WEB PUSH (VAPID — sinh bằng: npm run gen:vapid)
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ==============================================================================
# 5. CƠ SỞ DỮ LIỆU & NEON (PostgreSQL / Supabase Direct / Neon Activity)
# ==============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foodsave
DATABASE_USER=postgres
DATABASE_PASSWORD=foodsave_secure_local_password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Khi đặt DATABASE_URL / SUPABASE_DATABASE_URL thì ưu tiên hơn DATABASE_HOST/PORT/NAME/USER/PASSWORD
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Neon Database & Realtime (cô lập với Supabase Postgres; có thể đặt trong .env.local ở thư mục gốc)
NEON_ACTIVITY_ENABLED=true
NEON_DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# ==============================================================================
# 6. QUAN SÁT, LOGGING & RATE-LIMIT (Observability / Sentry / Upstash Redis)
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=text
SENTRY_DSN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# ==============================================================================
# 7. CỜ TÍNH NĂNG MỞ RỘNG (RPC Nguyên Tử, Outbox, Xác Thực JWT Cục Bộ)
# ==============================================================================
ORDER_ATOMIC_RPC_ENABLED=false
SELLER_REPUTATION_RPC_ENABLED=false
LOCATION_RPC_ENABLED=false
OUTBOX_ENABLED=false
AUTH_LOCAL_JWT_VERIFY=false
SUPABASE_JWT_SECRET=
COMPLAINT_STORAGE_BUCKET=partner-assets
