{
  "name": "mio",
  "version": "1.0.0",
  "private": true,
  "description": "MIO — nền tảng kết nối thực phẩm, cửa hàng và cộng đồng.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "start": "node dist/server.js",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsc && node dist/server.js",
    "check": "node scripts/check-project.mjs",
    "test": "npm run build && node --test tests/dev-server.test.mjs tests/frontend-config.test.mjs tests/project-integrity.test.mjs tests/neon-activity.test.mjs tests/environment-loader.test.mjs tests/zod-compatibility.test.mjs tests/backend-release.test.mjs tests/charity-onboarding.test.mjs tests/admin-core.test.mjs tests/admin-portal.test.mjs tests/p0-live-fixes.test.mjs",
    "test:admin": "tsc && node scripts/test-admin-api.js",
    "test:order": "tsc && node scripts/test-order-policy.js && node scripts/test-order-flow.js",
    "test:location": "tsc && node scripts/test-live-location.js",
    "test:ci": "npm run typecheck && npm run check && npm test && npm run test:order && npm run test:admin && npm run test:location",
    "test:ledger-db": "node scripts/test-ledger-concurrency.js",
    "db:neon:migrate": "node scripts/neon-migrate.mjs",
    "test:neon:e2e": "node scripts/test-neon-e2e.mjs",
    "gen:payout-key": "node scripts/generate-payout-key.js",
    "migrate:bank-dry": "node scripts/migrate-bank-accounts.js",
    "gen:vapid": "node scripts/generate-vapid-keys.js",
    "start:neon": "node scripts/start-neon.mjs",
    "start:api": "node scripts/start-neon-api.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neon/realtime": "^0.2.1",
    "@neondatabase/serverless": "^1.2.1",
    "@supabase/supabase-js": "^2.112.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "pg": "^8.22.0",
    "serverless-http": "^3.2.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.14.6",
    "@playwright/test": "^1.65.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
