# ==============================================================================
# 1. BẮT BUỘC & CẤU HÌNH CỐT LÕI (Server, Supabase, OAuth, CORS)
# ==============================================================================
NODE_ENV=production
PORT=8080
API_BASE_PATH=/api/v1
PUBLIC_SITE_URL=https://YOUR_FRONTEND_DOMAIN/FOODSAVE_USER.html

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

PASSWORD_RESET_REDIRECT_URL=https://YOUR_FRONTEND_DOMAIN/reset-password
GOOGLE_OAUTH_REDIRECT_URL=https://YOUR_FRONTEND_DOMAIN/FOODSAVE_USER.html
FACEBOOK_OAUTH_REDIRECT_URL=https://YOUR_FRONTEND_DOMAIN/FOODSAVE_USER.html
GOOGLE_OTP_EXPIRES_SECONDS=600
PHONE_OTP_EXPIRES_SECONDS=600

# Bí mật riêng >= 32 ký tự để ký token tình nguyện viên (khuyến nghị bắt buộc trên production)
VOLUNTEER_TOKEN_SECRET=

CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
SOCKET_CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# ==============================================================================
# 2. THANH TOÁN & CHI TRẢ (Payment / MoMo / Payout / Mã hóa số tài khoản)
# ==============================================================================
PAYMENT_PROVIDER=simulated
PAYOUT_PROVIDER=manual

# Khóa mã hóa AES-256-GCM (32 byte base64 hoặc 64 hex) hoặc bộ đa khóa xoay vòng "v2:<64hex>,v1:<64hex>"
PAYOUT_ENCRYPTION_KEY=
PAYOUT_ENCRYPTION_KEYS=

MOMO_API_BASE_URL=https://payment.momo.vn/v2/gateway/api
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://YOUR_FRONTEND_DOMAIN/api/v1/orders/payments/momo/return
MOMO_IPN_URL=https://YOUR_FRONTEND_DOMAIN/api/v1/orders/payments/momo/webhook/mock

# ==============================================================================
# 3. TỰ ĐỘNG HÓA, CHÍNH SÁCH VẬN HÀNH & MARKETING (Automation / Demo / n8n / FB)
# ==============================================================================
# Trên Netlify để false (dùng Scheduled Function); chỉ bật true trên server chạy nền duy nhất
AUTOMATION_ENABLED=false
LABEL_AUTOMATION_INTERVAL_MS=300000
PHOTO_REVIEW_MINUTES=360
PHOTO_GPS_MAX_METERS=500
DEMO_MODE=false
ORDER_POLICY_TIME_SCALE=1

N8N_WEBHOOK_URL=
N8N_SECRET=
N8N_CENTRAL_WEBHOOK_URL=
FACEBOOK_PAGE_TOKENS=
CENTRAL_PAGE_ID=
CENTRAL_PAGE_NAME=

# ==============================================================================
# 4. THÔNG BÁO ĐẨY WEB PUSH (VAPID)
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ==============================================================================
# 5. CƠ SỞ DỮ LIỆU & NEON (PostgreSQL / Supabase Direct / Neon Activity)
# ==============================================================================
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foodsave
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Neon Database & Realtime (cô lập với Supabase Postgres)
NEON_ACTIVITY_ENABLED=true
NEON_DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# ==============================================================================
# 6. QUAN SÁT, LOGGING & RATE-LIMIT (Observability / Sentry / Upstash Redis)
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# ==============================================================================
# 7. CỜ TÍNH NĂNG MỞ RỘNG (RPC Nguyên Tử, Outbox, Xác Thực JWT Cục Bộ)
# ==============================================================================
ORDER_ATOMIC_RPC_ENABLED=false
SELLER_REPUTATION_RPC_ENABLED=false
LOCATION_RPC_ENABLED=false
OUTBOX_ENABLED=false
AUTH_LOCAL_JWT_VERIFY=false
SUPABASE_JWT_SECRET=
COMPLAINT_STORAGE_BUCKET=partner-assets
